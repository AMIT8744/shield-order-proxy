{
  "version": 2,
  "functions": {
    "order.js": {
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/api/order",
      "dest": "/order.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        }
      ]
    }
  ]
}
